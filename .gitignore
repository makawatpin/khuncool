# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
# Any log a local run drops in the working tree, not just the package
# managers' own. `npm-debug.log*` did not match debug.log or .devserver.log,
# so those showed up as untracked changes waiting to be committed by mistake.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# npm's cache when it is pointed inside the repo (npm_config_cache=.npm-cache).
# It is thousands of files and must never reach a commit.
.npm-cache/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.superpowers/

# Local AI assistant settings
.claude/settings.local.json

# stage audit output (screenshots, generated per run)
/audit-output/

# codex worktrees (full repo copies incl. build output)
/.codex/
